<scene version="3.0.0">
    <integrator type="path">
        <integer name="max_depth" value="4"/>
    </integrator>
    <sensor type="perspective">
        <float name="fov" value="40"/>
        <transform name="to_world">
            <lookat origin="0, 0, 5" target="0, 0, 0" up="0, 1, 0"/>
        </transform>
        <sampler type="independent">
            <integer name="sample_count" value="4"/>
        </sampler>
        <film type="hdrfilm">
            <integer name="width" value="16"/>
            <integer name="height" value="16"/>
            <rfilter type="gaussian"/>
        </film>
    </sensor>
    <bsdf type="roughconductor" id="metal">
        <string name="material" value="Cu"/>
        <float name="alpha" value="0.2"/>
    </bsdf>
    <shape type="sphere">
        <float name="radius" value="1"/>
        <ref id="metal"/>
    </shape>
    <shape type="rectangle">
        <transform name="to_world">
            <scale value="3"/>
            <translate value="0, 0, -1"/>
        </transform>
        <bsdf type="diffuse">
            <texture type="checkerboard" name="reflectance"/>
        </bsdf>
    </shape>
    <shape type="cube">
        <transform name="to_world">
            <translate value="0, 3, 0"/>
        </transform>
        <emitter type="area">
            <rgb name="radiance" value="4, 4, 4"/>
        </emitter>
    </shape>
    <emitter type="constant">
        <rgb name="radiance" value="0.1"/>
    </emitter>
</scene>
